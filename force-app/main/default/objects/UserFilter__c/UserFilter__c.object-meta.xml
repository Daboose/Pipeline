<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
  <deploymentStatus>Deployed</deploymentStatus>
  <description
  >A Shared Object for User Filters. One record per saved filter, owned by the person who saved it and private to them. The Solution field says which solution the filter belongs to. Not meant to be viewed or edited by hand: there is no tab.</description>
  <enableActivities>false</enableActivities>
  <enableBulkApi>true</enableBulkApi>
  <enableFeeds>false</enableFeeds>
  <enableHistory>false</enableHistory>
  <enableReports>false</enableReports>
  <enableSearch>false</enableSearch>
  <enableSharing>true</enableSharing>
  <enableStreamingApi>true</enableStreamingApi>
  <externalSharingModel>Private</externalSharingModel>
  <label>UserFilter</label>
  <nameField>
    <label>Filter Name</label>
    <trackHistory>false</trackHistory>
    <type>Text</type>
  </nameField>
  <pluralLabel>UserFilters</pluralLabel>
  <sharingModel>Private</sharingModel>
  <visibility>Public</visibility>
</CustomObject>
