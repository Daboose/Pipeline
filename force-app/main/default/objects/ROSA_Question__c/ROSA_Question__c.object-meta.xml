<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description
  >ROSA Shoulder POC: one credentialing question in a ROSA Question Set (text, answer type, required, order). Each surgeon on the set's pathway gets an answer for it. ROSA's own; not shared with APAC Events.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>ROSA Question</label>
    <nameField>
        <displayFormat>ROSA Question-{0000}</displayFormat>
        <label>ROSA Question ID</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>ROSA Questions</pluralLabel>
    <searchLayouts />
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
