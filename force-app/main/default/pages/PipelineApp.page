<apex:page
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
  applyBodyTag="false"
  docType="html-5.0"
>
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Pipeline</title>
      <style>
        html,
        body {
          margin: 0;
          padding: 0;
          height: 100%;
          width: 100%;
          overflow: hidden;
          background: #141e2e;
          font-family:
            -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        #pipeline-container {
          width: 100%;
          height: 100vh;
          background: #141e2e;
        }
        *::-webkit-scrollbar {
          width: 10px;
          height: 10px;
        }
        *::-webkit-scrollbar-track {
          background: transparent;
        }
        *::-webkit-scrollbar-thumb {
          background: #475569;
          border-radius: 8px;
          border: 2px solid transparent;
          background-clip: padding-box;
        }
        * {
          scrollbar-width: thin;
          scrollbar-color: #475569 transparent;
        }
        /* the Pipeline loading screen, from the settled mockup */
        #splash {
          position: fixed;
          inset: 0;
          z-index: 60;
          background: #141e2e;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          gap: 26px;
          cursor: pointer;
          transition: opacity 0.6s;
        }
        #splash.gone {
          opacity: 0;
          pointer-events: none;
        }
        .splogo {
          position: relative;
          width: min(760px, 86%);
          container-type: inline-size;
        }
        .splogo img {
          width: 100%;
          display: block;
        }
        .spname {
          position: absolute;
          inset: 0;
          display: flex;
          align-items: center;
          padding-left: 19.4cqw;
          font-size: 7.6cqw;
          font-weight: 800;
          letter-spacing: 0.01em;
        }
        svg.spname {
          display: block;
          width: 100%;
          height: 100%;
          padding: 0;
          font-family:
            Poppins,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            Roboto,
            sans-serif;
        }
        .spname .a {
          color: #fdb827;
        }
        .spname .b {
          color: #eef3fa;
        }
        #splash .splogo {
          position: absolute;
          left: 50%;
          top: 50%;
          transform: translate(-50%, -50%);
          width: min(1140px, 92%);
        }
        #splash {
          transition: opacity 0.4s ease;
        }
        /* phone message: shown instead of the tool on a phone */
        #splash .mnote {
          display: none;
          position: absolute;
          left: 0;
          right: 0;
          top: calc(100% + 7cqw);
          text-align: center;
          color: #eef3fa;
          font-size: max(3cqw, 17px);
          line-height: 1.45;
        }
        #splash .mnote b {
          display: block;
          margin-bottom: 0.4em;
          color: #fdb827;
          font-size: 1.25em;
          letter-spacing: 0.04em;
          text-transform: uppercase;
        }
        #splash.phone {
          cursor: default;
        }
        #splash.phone .mnote {
          display: block;
        }
      </style>
    </head>
    <body>
      <div id="splash">
        <div class="splogo">
          <img
            src="data:image/svg+xml;base64,"
            alt=""
          />
          <!-- prettier-ignore -->
          <!-- prettier-ignore --><svg class="spname" viewBox="225 1100 4770 800" aria-hidden="true"><text x="1860" y="1500" dy="0.36em" text-anchor="middle" font-size="300" font-weight="800" letter-spacing="16"><tspan fill="#fdb827">PIPE</tspan><tspan fill="#eef3fa">LINE</tspan></text></svg>
          <div class="mnote">
            <b>Not designed for mobile</b>
            Pipeline is built for a desktop or laptop screen.<br />Please open
            it there.
          </div>
        </div>
      </div>
      <div id="pipeline-container"></div>

      <apex:includeLightning />

      <script>
        // The tool announces (a bubbling "pipelineready" event) when its first read of the deals is finished; the
        // loading screen (the logo on its own) then fades away after showing for at least 1 second (Robert, 2026-11-07). It also goes by itself after 12 s.
        var pipelineSplashStart = Date.now();
        var pipelineSplashGone = false;
        // A phone gets a short message instead of the tool (Pipeline is built for desktop; the rep phone view comes later).
        // A phone is judged by the device, not the window: a phone browser or the Salesforce mobile app, or a small touch screen,
        // so a narrowed desktop window and tablets still open the tool. Adding ?pipelinephone=1 to the address shows the message anywhere (for testing).
        var pipelinePhone = (function () {
          try {
            if (/[?&]pipelinephone=1/.test(location.search)) {
              return true;
            }
            if (
              /iPhone|iPod|Windows Phone|Android.*Mobile|Mobile.*Android/i.test(
                navigator.userAgent || ""
              )
            ) {
              return true;
            }
            var touch =
              "ontouchstart" in window || navigator.maxTouchPoints > 0;
            return touch && Math.min(screen.width, screen.height) < 600;
          } catch (e) {
            return false;
          }
        })();
        function pipelineSplashReady() {
          if (pipelineSplashGone || pipelinePhone) {
            return;
          }
          pipelineSplashGone = true;
          var wait = Math.max(0, 1000 - (Date.now() - pipelineSplashStart));
          setTimeout(function () {
            var el = document.getElementById("splash");
            if (!el) {
              return;
            }
            el.classList.add("gone");
            setTimeout(function () {
              el.style.display = "none";
            }, 450);
          }, wait);
        }
        document.addEventListener("pipelineready", pipelineSplashReady);
        setTimeout(pipelineSplashReady, 12000);
        // A deal row in the tool announces "pipelineopenrecord". Inside Salesforce the record is opened by Salesforce's own
        // navigation (no new browser tab); outside Salesforce there is nothing to answer and the tool opens its own tab.
        document.addEventListener("pipelineopenrecord", function (event) {
          try {
            var d = JSON.parse(event.detail || "{}");
            if (window.sforce && sforce.one && d.recordId) {
              sforce.one.navigateToSObject(d.recordId, "view");
              event.preventDefault();
            }
          } catch (e) {
            // not answered: the tool falls back to a new tab
          }
        });
        if (pipelinePhone) {
          document.getElementById("splash").classList.add("phone");
        } else {
          $Lightning.use("c:PipelineOut", function () {
            $Lightning.createComponent(
              "c:pipelineApp",
              {},
              "pipeline-container",
              function () {}
            );
          });
        }
      </script>
    </body>
  </html>
</apex:page>
