<apex:page
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
  applyBodyTag="false"
  docType="html-5.0"
>
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>Sales Campaign Management</title>
      <style>
        html,
        body {
          margin: 0;
          padding: 0;
          height: 100%;
          width: 100%;
          overflow: hidden;
          background: #141e2e;
          font-family:
            -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        #campaign-container {
          width: 100%;
          height: 100vh;
          background: #141e2e;
        }
        *::-webkit-scrollbar {
          width: 10px;
          height: 10px;
        }
        *::-webkit-scrollbar-track {
          background: transparent;
        }
        *::-webkit-scrollbar-thumb {
          background: #475569;
          border-radius: 8px;
          border: 2px solid transparent;
          background-clip: padding-box;
        }
        * {
          scrollbar-width: thin;
          scrollbar-color: #475569 transparent;
        }
      </style>
      <apex:includeLightning />
    </head>
    <body>
      <div id="campaign-container"></div>
      <script>
        $Lightning.use("c:PipelineCampaignOut", function () {
          $Lightning.createComponent(
            "c:pipelineCampaigns",
            {},
            "campaign-container",
            function () {}
          );
        });
      </script>
    </body>
  </html>
</apex:page>
