<apex:page
  showHeader="false"
  sidebar="false"
  standardStylesheets="false"
  applyBodyTag="false"
  docType="html-5.0"
>
  <!-- ROSA deal screen, full window with no Salesforce frame (Robert, 2026-11-28). Opened by the deal page's Open ROSA deal
       button as /apex/ROSADeal?id=<deal Id>; Close goes back to the deal. -->
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <title>ROSA deal</title>
      <style>
        html,
        body {
          margin: 0;
          padding: 0;
          height: 100%;
          width: 100%;
          overflow: hidden;
          background: #141e2e;
          font-family:
            -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        #rosa-container {
          width: 100%;
          height: 100vh;
        }
        *::-webkit-scrollbar {
          width: 10px;
          height: 10px;
        }
        *::-webkit-scrollbar-track {
          background: transparent;
        }
        *::-webkit-scrollbar-thumb {
          background: #475569;
          border-radius: 8px;
          border: 2px solid transparent;
          background-clip: padding-box;
        }
        * {
          scrollbar-width: thin;
          scrollbar-color: #475569 transparent;
        }
      </style>
    </head>
    <body>
      <div id="rosa-container"></div>
      <apex:includeLightning />
      <script>
        $Lightning.use("c:ROSADealOut", function () {
          $Lightning.createComponent(
            "c:rosaDeal",
            {
              dealId: "{!JSENCODE($CurrentPage.parameters.id)}",
              fullPage: true
            },
            "rosa-container",
            function () {}
          );
        });
      </script>
    </body>
  </html>
</apex:page>
